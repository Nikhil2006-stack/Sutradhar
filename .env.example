# =============================================================================
# SUTRADHAR — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local development. Never commit real secrets.
# =============================================================================

# --- Application Settings ---
APP_NAME=Sutradhar
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-in-production-use-64-char-random-hex-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Database (PostgreSQL + pgvector recommended; SQLite fallback supported for quick local dev) ---
DATABASE_URL=postgresql+psycopg://sutradhar:sutradhar_pass@localhost:5432/sutradhar
# Optional fallback if running without Docker/PostgreSQL credentials configured:
# DATABASE_URL=sqlite:///./sutradhar_local.db

# --- Redis & Background Worker (Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Object Storage (Local Private Storage or S3-Compatible / AWS S3 / Cloudflare R2) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=15
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=sutradhar-documents
S3_REGION=ap-south-1

# --- AI & Machine Learning Providers ---
# Supported LLM_PROVIDER values: auto | gemini | openai | deterministic
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# --- Frontend Build Variables ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Sutradhar

